[Unit]
Description=Garmin Data Proxy API Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/twain/AndroidStudioProjects/tail/garmin_proxy
Environment="PATH=/home/twain/AndroidStudioProjects/tail/garmin_proxy/venv/bin:/usr/bin:/bin"
EnvironmentFile=/home/twain/AndroidStudioProjects/tail/garmin_proxy/.env
ExecStart=/home/twain/AndroidStudioProjects/tail/garmin_proxy/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=default.target