# Environment for the habitsdb restic backup (loaded by tail_supervisor and
# by scripts/backup/restic_habitsdb.sh when run standalone).
# NOTE: the actual repository password lives OUTSIDE the repo, in
#   ~/.config/tail/restic_habitsdb.pass  (chmod 600, never committed).
RESTIC_REPOSITORY=/home/twain/backups/habitsdb-restic
RESTIC_PASSWORD_FILE=/home/twain/.config/tail/restic_habitsdb.pass
