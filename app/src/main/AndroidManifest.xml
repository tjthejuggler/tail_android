<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for AI icon generation API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for daily location tracking feature -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Required for voice trigger feature (SpeechRecognizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required for meal vision capture (CameraX) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Custom signature permission for IPC.
        Only apps signed with the same keystore can use the ContentProvider or
        send the increment broadcast.
    -->
    <permission
        android:name="com.example.tail.permission.TAIL_INTEGRATION"
        android:protectionLevel="signature"
        android:label="Tail Integration"
        android:description="@string/permission_tail_integration_description" />

    <!--
        Tail must hold its own signature permission so that when wags calls
        sendBroadcast(intent, PERMISSION_TAIL) — which requires the *receiver*
        to hold the permission — the broadcast is actually delivered here.
    -->
    <uses-permission android:name="com.example.tail.permission.TAIL_INTEGRATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tail"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Tail"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            VoiceTriggerActivity: transparent activity for the voice-listening
            habit trigger shortcut. Starts VoiceHabitService without EXTRA_TEXT
            so it uses SpeechRecognizer.
        -->
        <activity
            android:name=".VoiceTriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_VOICE_TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            TextTriggerActivity: transparent activity for the text-passthrough
            habit trigger shortcut. Extracts text from the intent and starts
            VoiceHabitService with EXTRA_TEXT so it skips SpeechRecognizer.
        -->
        <activity
            android:name=".TextTriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_TEXT_TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            ShareTextActivity: appears in the system share sheet when the user
            highlights text and taps "Share". Lets them pick a text-input habit
            and saves the shared text as a log entry for that habit.
            The transparent theme makes it look like a floating dialog rather
            than a full-screen activity.
        -->
        <activity
            android:name=".ShareTextActivity"
            android:exported="true"
            android:label="@string/share_activity_label"
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            ContentProvider: exposes the habit list (habit_id, habit_name) to same-keystore apps.
            android:readPermission restricts query() to callers holding TAIL_INTEGRATION.
            Write operations are not permitted (UnsupportedOperationException in code).
        -->
        <provider
            android:name=".ipc.HabitsContentProvider"
            android:authorities="com.example.tail.provider"
            android:exported="true"
            android:readPermission="com.example.tail.permission.TAIL_INTEGRATION" />

        <!--
            BroadcastReceiver: listens for ACTION_INCREMENT_HABIT from same-keystore apps.
            android:permission restricts which senders can deliver the broadcast.
        -->
        <receiver
            android:name=".ipc.HabitIncrementReceiver"
            android:exported="true"
            android:permission="com.example.tail.permission.TAIL_INTEGRATION">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_INCREMENT_HABIT" />
            </intent-filter>
        </receiver>

        <!--
            BroadcastReceiver (Protocol v2): listens for ACTION_SET_HABIT_VALUES
            from same-keystore apps. Used by WAGS for the retroactive backfill of
            past session minutes. SETS (replaces) the stored value for each date
            in the JSON payload, making the operation idempotent.
        -->
        <receiver
            android:name=".ipc.HabitValueSetReceiver"
            android:exported="true"
            android:permission="com.example.tail.permission.TAIL_INTEGRATION">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_SET_HABIT_VALUES" />
            </intent-filter>
        </receiver>

        <!--
            VoiceHabitReceiver: listens for ACTION_VOICE_HABIT from Samsung Routines
            (or any external automation). Exported without permission restriction
            because Samsung Routines is not signed with our keystore.
        -->
        <receiver
            android:name=".ipc.VoiceHabitReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_VOICE_HABIT" />
            </intent-filter>
        </receiver>

        <!--
            VoiceHabitService: foreground service that uses SpeechRecognizer to
            listen for voice trigger words and increment matching habits.
            Not exported — only started internally by VoiceHabitReceiver.
        -->
        <service
            android:name=".ipc.VoiceHabitService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            VoiceNoteActivity: transparent activity for the voice-listening
            note shortcut. Starts VoiceNoteService without EXTRA_TEXT
            so it uses SpeechRecognizer.
        -->
        <activity
            android:name=".VoiceNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_VOICE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            TextNoteActivity: transparent activity for the text-passthrough
            note shortcut. Extracts text from the intent and starts
            VoiceNoteService with EXTRA_TEXT so it skips SpeechRecognizer.
        -->
        <activity
            android:name=".TextNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_TEXT_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            SmartVoiceActivity: transparent activity for the smart voice shortcut.
            Starts SmartVoiceService without EXTRA_TEXT so it uses SpeechRecognizer.
            The service routes recognized text to either habit incrementing or
            note saving based on trigger word density.
        -->
        <activity
            android:name=".SmartVoiceActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_SMART_VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            HabitIncrementConfirmActivity: shows a brief confirmation message
            over the lock screen after a voice/smart voice habit increment.
            Auto-dismisses after 3 seconds.
        -->
        <activity
            android:name=".ui.HabitIncrementConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Tail.Transparent" />

        <!--
            VoiceNoteService: foreground service that uses SpeechRecognizer to
            listen for dictated speech and prepend it to a notes markdown file.
        -->
        <service
            android:name=".ipc.VoiceNoteService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            SmartVoiceService: foreground service that uses SpeechRecognizer to
            listen for voice input, then smartly routes it to either habit
            incrementing (if most words match trigger words) or note saving.
        -->
        <service
            android:name=".ipc.SmartVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            MusicNotificationListenerService: required for MediaSessionManager.getActiveSessions()
            to detect currently playing Spotify tracks. The user must enable this in
            Android Settings → Apps → Special access → Notification access.
            This service does not intercept or modify any notifications.
        -->
        <service
            android:name=".ipc.MusicNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            ════════════════════════════════════════════════════════════════
            Lock-screen Habit List Widget
            ════════════════════════════════════════════════════════════════

            HabitListWidgetProvider: AppWidgetProvider that renders the
            collapsed bar / expanded scrollable habit list. Handles all of:
              - tap-to-arm / second-tap-to-expand (accident-resistance)
              - per-row tap → habit increment (normal / max-one)
              - per-row tap → launches WidgetInputActivity (text-input habits)
              - auto-disarm timeout (alarm-driven)
              - per-widget DataStore state (recent-tap order, max1-today set)
        -->
        <receiver
            android:name=".widget.HabitListWidgetProvider"
            android:exported="true"
            android:label="Tail habits">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Custom actions used by the widget itself -->
                <action android:name="com.example.tail.widget.ARM" />
                <action android:name="com.example.tail.widget.DISARM" />
                <action android:name="com.example.tail.widget.EXPAND" />
                <action android:name="com.example.tail.widget.COLLAPSE" />
                <action android:name="com.example.tail.widget.INCREMENT" />
                <action android:name="com.example.tail.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            HabitListRemoteViewsService: backs the ListView inside the expanded
            widget. Must hold android.permission.BIND_REMOTEVIEWS so only the
            system can bind to it (Android requires this for RemoteViewsService).
        -->
        <service
            android:name=".widget.HabitListRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!--
            WidgetInputActivity: transparent trampoline that shows the
            TextInputDialog when the user taps a text-input habit from the
            widget. Reuses Theme.Tail.Transparent so only the dialog is visible.
            Single-task / no-history so it can't end up in the recents stack.
        -->
        <activity
            android:name=".widget.WidgetInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tail.Transparent" />

        <!--
            QuickCaptureActivity: full-screen camera capture for the meal
            vision pipeline. Launched from a launcher shortcut or Samsung
            Routines. Shows CameraX preview, captures on tap, saves the
            image to internal storage, enqueues it for LLM vision
            processing, then finishes immediately.
        -->
        <activity
            android:name=".QuickCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tail">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_QUICK_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
