<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for AI icon generation API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for the App Link feature: querying installed apps to show in the picker -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Required for daily location tracking feature -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Required for voice trigger feature (SpeechRecognizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required for meal vision capture (CameraX) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Required for the floating bubble overlay (draw over other apps) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required for the widget trigger feature (detecting foreground apps).
         This is an app-ops permission the user grants via
         Settings → Special app access → Usage access. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Required for the floating bubble foreground service on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Required so the widget watchdog can revive the monitor after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required for habit-ask notifications (system notifications with
         Yes/No actions) on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for the daily scheduled habit asks. Falls back to an
         inexact allow-while-idle alarm when the exact-alarm grant is absent. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Required for the points-driven wallpaper feature (set home/lock wallpaper). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
        Custom signature permission for IPC.
        Only apps signed with the same keystore can use the ContentProvider or
        send the increment broadcast.
    -->
    <permission
        android:name="com.example.tail.permission.TAIL_INTEGRATION"
        android:protectionLevel="signature"
        android:label="Tail Integration"
        android:description="@string/permission_tail_integration_description" />

    <!--
        Tail must hold its own signature permission so that when wags calls
        sendBroadcast(intent, PERMISSION_TAIL) — which requires the *receiver*
        to hold the permission — the broadcast is actually delivered here.
    -->
    <uses-permission android:name="com.example.tail.permission.TAIL_INTEGRATION" />

    <application
        android:name=".TailApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tail"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Tail"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

-------
        <!--
            ShareTextActivity: appears in the system share sheet when the user
            highlights text and taps "Share". Lets them pick a text-input habit
            and saves the shared text as a log entry for that habit.
            The transparent theme makes it look like a floating dialog rather
            than a full-screen activity.
        -->
        <activity
            android:name=".ShareTextActivity"
            android:exported="true"
            android:label="@string/share_activity_label"
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            ChessGameShareActivity: appears in the system share sheet as
            "♟ Chess Audit". When the user shares a finished chess.com game
            link to Tail, it extracts the game ID, verifies rated play is
            authorized (Phase 1 green-light window), fetches the game from
            the chess.com archive API and runs the Phase 2 post-game audit
            automatically — no manual data entry.
        -->
        <activity
            android:name=".ChessGameShareActivity"
            android:exported="true"
            android:label="@string/chess_share_activity_label"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            ContentProvider: exposes the habit list (habit_id, habit_name) to same-keystore apps.
            android:readPermission restricts query() to callers holding TAIL_INTEGRATION.
            Write operations are not permitted (UnsupportedOperationException in code).
        -->
        <provider
            android:name=".ipc.HabitsContentProvider"
            android:authorities="com.example.tail.provider"
            android:exported="true"
            android:readPermission="com.example.tail.permission.TAIL_INTEGRATION" />

        <!--
            FileProvider: hands ACTION_IMAGE_CAPTURE (system camera) a writable
            content URI inside files/meal_images/ so the meal editor can snap a
            photo and analyse it with the LLM inline (see res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.tail.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            BroadcastReceiver: listens for ACTION_INCREMENT_HABIT from same-keystore apps.
            android:permission restricts which senders can deliver the broadcast.
        -->
        <receiver
            android:name=".ipc.HabitIncrementReceiver"
            android:exported="true"
            android:permission="com.example.tail.permission.TAIL_INTEGRATION">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_INCREMENT_HABIT" />
            </intent-filter>
        </receiver>

        <!--
            BroadcastReceiver (Protocol v2): listens for ACTION_SET_HABIT_VALUES
            from same-keystore apps. Used by WAGS for the retroactive backfill of
            past session minutes. SETS (replaces) the stored value for each date
            in the JSON payload, making the operation idempotent.
        -->
        <receiver
            android:name=".ipc.HabitValueSetReceiver"
            android:exported="true"
            android:permission="com.example.tail.permission.TAIL_INTEGRATION">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_SET_HABIT_VALUES" />
            </intent-filter>
        </receiver>

        <!--
            BroadcastReceiver (Protocol v3, JugCoach): listens for
            ACTION_JUGCOACH_SESSION from the JugCoach app. One broadcast per
            completed juggling run atomically increments the mapped habit's
            binary "used" count plus six secondary-value slots: total seconds,
            total catches, seconds/catches in catch-ended runs and seconds/
            catches in drop-ended runs (secondary_value … secondary_value6).
        -->
        <receiver
            android:name=".ipc.JugCoachSessionReceiver"
            android:exported="true"
            android:permission="com.example.tail.permission.TAIL_INTEGRATION">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_JUGCOACH_SESSION" />
                <action android:name="com.example.tail.ACTION_JUGCOACH_BACKFILL" />
            </intent-filter>
        </receiver>

-------
        <!--
            HabitIncrementConfirmActivity: shows a brief confirmation message
            over the lock screen after a voice/smart voice habit increment.
            Auto-dismisses after 3 seconds.
        -->
        <activity
            android:name=".ui.HabitIncrementConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Tail.Transparent" />

-------
        <!--
            SmartVoiceService: foreground service that uses SpeechRecognizer to
            listen for voice input, then smartly routes it to either habit
            incrementing (if most words match trigger words) or note saving.
        -->
        <service
            android:name=".ipc.SmartVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            MusicNotificationListenerService: required for MediaSessionManager.getActiveSessions()
            to detect currently playing Spotify tracks. The user must enable this in
            Android Settings → Apps → Special access → Notification access.
            This service does not intercept or modify any notifications.
        -->
        <service
            android:name=".ipc.MusicNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            ChessGuardService: accessibility gate for the Chess Readiness
            system ("Chess Guard"). Watches TYPE_WINDOW_STATE_CHANGED events
            only (no window content is ever read) and, when the configured
            chess app is opened while the enforcement policy says blocked,
            performs GLOBAL_ACTION_HOME and shows the ChessGuardLockActivity
            wall. The user must enable it manually in
            Settings → Accessibility → Tail.
        -->
        <service
            android:name=".widget.ChessGuardService"
            android:exported="false"
            android:label="Tail Chess Guard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chess_guard_accessibility" />
        </service>

        <!--
            ChessGuardLockActivity: full-screen wall shown by the guard when
            the chess app is opened while blocked. Not in recents, own task,
            finishes itself the moment the policy turns into an Allow.
        -->
        <activity
            android:name=".widget.ChessGuardLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tail" />

        <!--
            ════════════════════════════════════════════════════════════════
            Lock-screen Habit List Widget
            ════════════════════════════════════════════════════════════════

            HabitListWidgetProvider: AppWidgetProvider that renders the
            collapsed bar / expanded scrollable habit list. Handles all of:
              - tap-to-arm / second-tap-to-expand (accident-resistance)
              - per-row tap → habit increment (normal / max-one)
              - per-row tap → launches WidgetInputActivity (text-input habits)
              - auto-disarm timeout (alarm-driven)
              - per-widget DataStore state (recent-tap order, max1-today set)
        -->
        <receiver
            android:name=".widget.HabitListWidgetProvider"
            android:exported="true"
            android:label="Tail habits">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Custom actions used by the widget itself -->
                <action android:name="com.example.tail.widget.ARM" />
                <action android:name="com.example.tail.widget.DISARM" />
                <action android:name="com.example.tail.widget.EXPAND" />
                <action android:name="com.example.tail.widget.COLLAPSE" />
                <action android:name="com.example.tail.widget.INCREMENT" />
                <action android:name="com.example.tail.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            HabitListRemoteViewsService: backs the ListView inside the expanded
            widget. Must hold android.permission.BIND_REMOTEVIEWS so only the
            system can bind to it (Android requires this for RemoteViewsService).
        -->
        <service
            android:name=".widget.HabitListRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!--
            WidgetInputActivity: transparent trampoline that shows the
            TextInputDialog when the user taps a text-input habit from the
            widget. Reuses Theme.Tail.Transparent so only the dialog is visible.
            Single-task / no-history so it can't end up in the recents stack.
        -->
        <activity
            android:name=".widget.WidgetInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tail.Transparent" />

        <!--
            QuickCaptureActivity: FIRE-AND-FORGET camera for the vision
            pipeline. Launched in-app (Meal Detail screen, camera-enabled
            habit taps) and system-wide via the launcher "Quick Capture"
            shortcut / Tasker (ACTION_QUICK_CAPTURE). Shows a CameraX
            preview, captures on tap, saves the image, enqueues it for
            background LLM processing, and finishes IMMEDIATELY — no
            waiting, no approval. Works over the lock screen. When exactly
            one camera habit is enabled the capture is deterministic: it
            runs the exact meal pipeline the manual editor uses.
        -->
        <activity
            android:name=".QuickCaptureActivity"
            android:exported="true"
            android:label="@string/shortcut_media_capture_short"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Tail">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_QUICK_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            MediaCaptureActivity: unified quick capture — voice AND camera.
            Voice starts IMMEDIATELY (SmartVoiceService with vibration);
            saying a habit or note closes the screen by itself. TAPPING the
            capture button is FIRE-AND-FORGET: the photo is queued for the
            background VisionProcessingWorker and the activity finishes
            immediately (no Processing/result/approval screens; failures
            land in the Quick Capture History). HOLDING the button runs the
            interactive tandem-teaching flow (photo + spoken instruction).
            Works on the lock screen. Launched by the launcher shortcut,
            Tasker explicit intents, and Samsung Routines.
        -->
        <activity
            android:name=".MediaCaptureActivity"
            android:exported="true"
            android:label="@string/shortcut_media_capture_short"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.ACTION_MEDIA_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            ════════════════════════════════════════════════════════════════
            Floating Bubble Overlay
            ════════════════════════════════════════════════════════════════

            FloatingBubbleActivity: transparent trampoline that checks for
            SYSTEM_ALERT_WINDOW permission and starts the bubble service.
            Launched from the Settings screen and from the launcher shortcut.
        -->
        <activity
            android:name=".widget.FloatingBubbleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tail.Transparent">
            <intent-filter>
                <action android:name="com.example.tail.widget.LAUNCH_BUBBLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            StatsOverlayService: foreground service that manages the always-on-top
            stats bar overlay (TYPE_APPLICATION_OVERLAY). Shows the same
            today / avg7 / avg30 point totals that the Tasker relay file
            receives, so the Tasker dependency can eventually be retired.
            The bar is draggable, resizable (corner handle) and revived by the
            watchdog after crashes/reboots. Uses foregroundServiceType="specialUse"
            as required on Android 14+.
        -->
        <service
            android:name=".widget.StatsOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent habit stats overlay bar" />
        </service>

        <!--
            FloatingBubbleService: foreground service that manages the
            WindowManager overlay (TYPE_APPLICATION_OVERLAY). Shows a
            draggable bubble with the Tail icon over other apps.
            Uses foregroundServiceType="specialUse" as required on Android 14+.
        -->
        <service
            android:name=".widget.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating overlay bubble for quick habit tracking access" />
        </service>

        <!--
            WidgetTriggerService: foreground service that monitors the
            foreground app (via UsageStatsManager) and automatically
            shows/hides the FloatingBubbleService when a habit's trigger
            app opens/closes. Started by the app when any habit has the
            "Use Widget" feature enabled with a trigger app selected.
        -->
        <service
            android:name=".widget.WidgetTriggerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App usage monitoring for automatic habit widget display" />
        </service>

        <!--
            WidgetWatchdogReceiver: self-healing watchdog for the widget
            stack. A 2-minute allow-while-idle heartbeat alarm restarts
            WidgetTriggerService whenever it should be running but was
            killed (APK install, crash, OEM cleanup — install-time kills
            do NOT restart START_STICKY services). BOOT_COMPLETED revives
            the monitor after a reboot.
        -->
        <receiver
            android:name=".widget.WidgetWatchdogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            NotificationActionReceiver: handles the Yes/No action buttons on
            habit-ask system notifications. Answering anywhere (system
            notification, in-app notification center or bottom flash)
            dismisses the ask everywhere at once.
        -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!--
            HabitAlarmReceiver: fires the daily scheduled habit asks
            (store record + system notification) and re-registers all
            alarms after a reboot — exact alarms do not survive one.
        -->
        <receiver
            android:name=".notify.HabitAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            WallpaperAlarmReceiver: daily refresh of the points-driven
            wallpaper (re-applies the image matching the selected point
            metric shortly after midnight) and re-scheduling after a
            reboot. Intraday point changes are handled by the post-save
            hook in HabitsRepository.
        -->
        <receiver
            android:name=".wallpaper.WallpaperAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            AppStatsAlarmReceiver: fires the daily evening check for the
            app-stats record notifications ("close to a new record" /
            "new all-time record" notices — see AppStatsRecordEngine) and
            re-schedules after a reboot. Missed alarms are covered by the
            app-open catch-up in HabitViewModel.
        -->
        <receiver
            android:name=".notify.AppStatsAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
