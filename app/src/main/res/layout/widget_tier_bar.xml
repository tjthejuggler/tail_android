<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-width tier bar widget: the whole strip's background is the current
    daily-points tier colour; the left segment shows the point total and the
    right side holds configurable quick-launch buttons for app tabs.
    Visibility of each button is driven from Settings (TierBarWidgetConfig).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tier_bar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:background="#FF33AA55">

    <TextView
        android:id="@+id/tier_bar_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tail · 0 pts"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FFFFFFFF"
        android:maxLines="1" />

    <!-- RemoteViews does not allow android.view.Space — an empty weighted
         TextView is the sanctioned spacer. -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:text=""
        android:maxLines="1" />

    <TextView
        android:id="@+id/tier_bar_btn_grid"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="▦"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
 />

    <TextView
        android:id="@+id/tier_bar_btn_map"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="🗺"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
 />

    <TextView
        android:id="@+id/tier_bar_btn_app_stats"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="📊"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
 />

    <TextView
        android:id="@+id/tier_bar_btn_chess_stats"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="♟"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
 />

    <TextView
        android:id="@+id/tier_bar_btn_settings"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="⚙"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
 />

</LinearLayout>
