<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded habit list widget. Sticky "Add Note" header + scrollable ListView
  fed by HabitListRemoteViewsService. No close button — the widget auto-collapses
  when the screen turns off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_panel_bg"
    android:padding="6dp">

    <!-- Sticky "Add Note" bar — always pinned above the scrollable list -->
    <TextView
        android:id="@+id/widget_add_note_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="✎  Add Note"
        android:textColor="#111111"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/widget_add_note_bg" />

    <!-- Scrollable habit list -->
    <ListView
        android:id="@+id/widget_habit_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="3dp"
        android:scrollbars="none"
        android:listSelector="@android:color/transparent" />

    <!-- Empty state (shown when the list has zero items) -->
    <TextView
        android:id="@+id/widget_empty_label"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No habits configured.\nOpen Tail to set up your habit list."
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
