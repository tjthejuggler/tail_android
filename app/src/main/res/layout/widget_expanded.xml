<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded habit list widget. Header + scrollable ListView fed by
  HabitListRemoteViewsService. No close button — the widget auto-collapses
  when the screen turns off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_panel_bg"
    android:padding="6dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:text="Habits"
        android:textColor="#FFD700"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Scrollable habit list -->
    <ListView
        android:id="@+id/widget_habit_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="3dp"
        android:scrollbars="none"
        android:listSelector="@android:color/transparent" />

    <!-- Empty state (shown when the list has zero items) -->
    <TextView
        android:id="@+id/widget_empty_label"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No habits configured.\nOpen Tail to set up your habit list."
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
