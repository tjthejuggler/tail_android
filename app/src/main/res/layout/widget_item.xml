<?xml version="1.0" encoding="utf-8"?>
<!--
  Single habit row in the widget list: small icon on the left, habit name beside it.
  Sized for ~8 visible rows in a typical 4x4-ish lock-screen widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_item_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:minHeight="40dp">

    <ImageView
        android:id="@+id/widget_item_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Habit icon" />

    <TextView
        android:id="@+id/widget_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
