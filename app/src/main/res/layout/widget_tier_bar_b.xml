<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-width tier bar widget: background is a runtime-composited bitmap
    (sky + surroundings + lizard, rounded corners) sized to the widget's
    actual aspect. A top bar holds the notification-count circle and the
    quick-launch icon circles (runtime bitmaps). The body is divided into
    invisible horizontal touch zones (one per selected habit screen).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tier_bar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tier_bar_bg">

    <ImageView
        android:id="@+id/tier_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Tail tier background" />

    <!-- Invisible horizontal touch zones: zone i opens the i-th selected
         habit grid screen. Filled by the provider; unused zones GONE. -->
    <LinearLayout
        android:id="@+id/tier_bar_zones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView android:id="@+id/tier_bar_zone_0" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_1" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_2" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_3" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_4" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_5" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_6" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tier_bar_zone_7" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <!-- Top bar: notification badge + quick-launch icon circles. All icons
         are runtime bitmaps (fill = daily tier colour, border = weekly,
         glyph = monthly). -->
    <LinearLayout
        android:id="@+id/tier_bar_top_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/tier_bar_notif"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Pending habit notifications" />

        <ImageView
            android:id="@+id/tier_bar_btn_grid"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Habits grid" />

        <ImageView
            android:id="@+id/tier_bar_btn_map"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Map" />

        <ImageView
            android:id="@+id/tier_bar_btn_app_stats"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="App stats" />

        <ImageView
            android:id="@+id/tier_bar_btn_chess_stats"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Chess readiness stats" />

        <ImageView
            android:id="@+id/tier_bar_btn_settings"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Settings" />
    </LinearLayout>
</FrameLayout>
