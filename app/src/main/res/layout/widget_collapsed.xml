<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed widget: transparent background so the lock screen wallpaper shows
  through. Only a small fingertip-sized outline button sits in the upper-right
  corner. Tapping it arms the widget; a second tap within 1.5 s expands it.

  Note: RemoteViews only supports a limited set of view types. A plain <View>
  is NOT supported — we use <ImageView> instead (with no src = invisible fill).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_collapsed_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Open habits"
        android:background="@drawable/widget_button_idle_bg" />

</FrameLayout>
