<?xml version="1.0" encoding="utf-8"?>
<!--
  "Armed" state for the collapsed bar — shown briefly between the first tap and
  the second confirming tap. Highlighted with a brighter background and orange
  border so the user sees the bar is awaiting their second tap.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF3A2A00" />
    <stroke android:width="2dp" android:color="#FFAA00" />
    <corners android:radius="8dp" />
</shape>
