<?xml version="1.0" encoding="utf-8"?>
<!--
  Idle state for the small collapsed-widget button. Just a subtle rounded
  outline — no fill — so it's visible against any wallpaper but not
  distracting.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="#AAFFAA00" />
    <corners android:radius="10dp" />
</shape>
