<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the sticky "Add Note" bar at the top of the expanded
  lock-screen widget. Warm amber pill matching the widget's gold accent
  (#FFD700 header / idle-button outline family).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6FFC94D" />
    <stroke android:width="1dp" android:color="#AAFFD700" />
    <corners android:radius="8dp" />
</shape>
