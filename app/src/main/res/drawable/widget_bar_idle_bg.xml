<?xml version="1.0" encoding="utf-8"?>
<!--
  Resting state for the collapsed habit-widget bar (and for the "×" close button
  in the expanded view). Dark, slightly translucent so it's readable on top of
  any wallpaper / lock-screen image.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC1E1E1E" />
    <stroke android:width="1dp" android:color="#FFAA00" />
    <corners android:radius="8dp" />
</shape>
