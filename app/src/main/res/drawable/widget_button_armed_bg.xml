<?xml version="1.0" encoding="utf-8"?>
<!--
  Armed state for the small collapsed-widget button. Filled orange so the
  user sees clear feedback that their first tap registered and a second tap
  will open the habit list.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CCFFAA00" />
    <stroke android:width="1.5dp" android:color="#FFFFAA00" />
    <corners android:radius="10dp" />
</shape>
