<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Static shortcut for "Quick Capture" — a unified launcher that combines
        voice and camera into a single shortcut. Appears FIRST in the launcher
        long-press menu and Samsung Routines.

        Launches MediaCaptureActivity which shows a chooser:
          - Voice: starts SmartVoiceService (smart routing to habits/notes)
          - Camera: opens CameraX preview, captures, processes the image
            inline through the vision pipeline (same code path as the
            Settings test button), shows the LLM result, then the user
            dismisses to return to their previous screen.
    -->
    <shortcut
        android:shortcutId="media_capture"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_media_capture_short"
        android:shortcutLongLabel="@string/shortcut_media_capture_long"
        android:icon="@android:drawable/ic_menu_camera">
        <intent
            android:action="com.example.tail.ACTION_MEDIA_CAPTURE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.MediaCaptureActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

-------

    <!--
        Static shortcut for "Floating Bubble" — launches the draggable
        Tail bubble overlay that floats over other apps.
        Appears in the launcher long-press menu and Samsung Routines.
    -->
    <shortcut
        android:shortcutId="floating_bubble"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_floating_bubble_short"
        android:shortcutLongLabel="@string/shortcut_floating_bubble_long"
        android:icon="@drawable/ic_bubble_notification">
        <intent
            android:action="com.example.tail.widget.LAUNCH_BUBBLE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.widget.FloatingBubbleActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
