<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Static shortcut for "Quick Capture" — FIRE-AND-FORGET camera.
        Appears FIRST in the launcher long-press menu and Samsung Routines.

        Launches QuickCaptureActivity: CameraX preview, one tap to capture,
        then the activity finishes IMMEDIATELY. The image is queued and the
        background VisionProcessingWorker runs the SAME deterministic meal
        pipeline the in-app meal habit camera uses (no waiting, no approval,
        no LLM habit guessing when a single camera habit is enabled). If the
        image can't be acted on, it lands in the Quick Capture History with
        a notification on next app open.

        The old voice+camera combo remains available via MediaCaptureActivity
        (explicit intent / Tasker ACTION_MEDIA_CAPTURE).
    -->
    <shortcut
        android:shortcutId="media_capture"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_media_capture_short"
        android:shortcutLongLabel="@string/shortcut_media_capture_long"
        android:icon="@android:drawable/ic_menu_camera">
        <intent
            android:action="com.example.tail.ACTION_QUICK_CAPTURE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.QuickCaptureActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

-------

    <!--
        Static shortcut for "Floating Bubble" — launches the draggable
        Tail bubble overlay that floats over other apps.
        Appears in the launcher long-press menu and Samsung Routines.
    -->
    <shortcut
        android:shortcutId="floating_bubble"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_floating_bubble_short"
        android:shortcutLongLabel="@string/shortcut_floating_bubble_long"
        android:icon="@drawable/ic_bubble_notification">
        <intent
            android:action="com.example.tail.widget.LAUNCH_BUBBLE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.widget.FloatingBubbleActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
