<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Static shortcut for "Voice Trigger" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Voice Trigger".
        Launches VoiceTriggerActivity which starts VoiceHabitService in
        voice-listening mode (uses SpeechRecognizer).
    -->
    <shortcut
        android:shortcutId="voice_trigger"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_voice_trigger_short"
        android:shortcutLongLabel="@string/shortcut_voice_trigger_long"
        android:icon="@android:drawable/ic_btn_speak_now">
        <intent
            android:action="com.example.tail.ACTION_VOICE_TRIGGER"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.VoiceTriggerActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Text Trigger" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Text Trigger".
        Launches TextTriggerActivity which starts VoiceHabitService in
        text-passthrough mode (expects pre-recognized text in EXTRA_TEXT,
        skips SpeechRecognizer).
    -->
    <shortcut
        android:shortcutId="text_trigger"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_text_trigger_short"
        android:shortcutLongLabel="@string/shortcut_text_trigger_long"
        android:icon="@android:drawable/ic_menu_edit">
        <intent
            android:action="com.example.tail.ACTION_TEXT_TRIGGER"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.TextTriggerActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Voice Note" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Voice Note".
        Launches VoiceNoteActivity which starts VoiceNoteService in
        voice-listening mode (uses SpeechRecognizer).
    -->
    <shortcut
        android:shortcutId="voice_note"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_voice_note_short"
        android:shortcutLongLabel="@string/shortcut_voice_note_long"
        android:icon="@android:drawable/ic_btn_speak_now">
        <intent
            android:action="com.example.tail.ACTION_VOICE_NOTE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.VoiceNoteActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Text Note" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Text Note".
        Launches TextNoteActivity which starts VoiceNoteService in
        text-passthrough mode (expects pre-recognized text in EXTRA_TEXT,
        skips SpeechRecognizer).
    -->
    <shortcut
        android:shortcutId="text_note"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_text_note_short"
        android:shortcutLongLabel="@string/shortcut_text_note_long"
        android:icon="@android:drawable/ic_menu_edit">
        <intent
            android:action="com.example.tail.ACTION_TEXT_NOTE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.TextNoteActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Smart Voice" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Smart Voice".
        Launches SmartVoiceActivity which starts SmartVoiceService in
        voice-listening mode. The service smartly routes recognized text
        to habit incrementing (if most words match trigger words) or
        note saving (if not).
    -->
    <shortcut
        android:shortcutId="smart_voice"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_smart_voice_short"
        android:shortcutLongLabel="@string/shortcut_smart_voice_long"
        android:icon="@android:drawable/ic_btn_speak_now">
        <intent
            android:action="com.example.tail.ACTION_SMART_VOICE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.SmartVoiceActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Snap Meal" — appears in the launcher long-press
        menu and Samsung Routines. Launches QuickCaptureActivity which opens
        the camera, captures on tap, and enqueues the photo for LLM vision
        analysis (food classification + nutrition extraction).
    -->
    <shortcut
        android:shortcutId="quick_capture"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_quick_capture_short"
        android:shortcutLongLabel="@string/shortcut_quick_capture_long"
        android:icon="@android:drawable/ic_menu_camera">
        <intent
            android:action="com.example.tail.ACTION_QUICK_CAPTURE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.QuickCaptureActivity" />
    </shortcut>

</shortcuts>
