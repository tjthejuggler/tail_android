<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Static shortcut for "Quick Capture" — a unified launcher that combines
        voice and camera into a single shortcut. Appears FIRST in the launcher
        long-press menu and Samsung Routines.

        Launches MediaCaptureActivity which shows a chooser:
          - Voice: starts SmartVoiceService (smart routing to habits/notes)
          - Camera: opens CameraX preview, captures, processes the image
            inline through the vision pipeline (same code path as the
            Settings test button), shows the LLM result, then the user
            dismisses to return to their previous screen.
    -->
    <shortcut
        android:shortcutId="media_capture"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_media_capture_short"
        android:shortcutLongLabel="@string/shortcut_media_capture_long"
        android:icon="@android:drawable/ic_menu_camera">
        <intent
            android:action="com.example.tail.ACTION_MEDIA_CAPTURE"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.MediaCaptureActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Voice Trigger" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Voice Trigger".
        Launches VoiceTriggerActivity which starts VoiceHabitService in
        voice-listening mode (uses SpeechRecognizer).
    -->
    <shortcut
        android:shortcutId="voice_trigger"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_voice_trigger_short"
        android:shortcutLongLabel="@string/shortcut_voice_trigger_long"
        android:icon="@android:drawable/ic_btn_speak_now">
        <intent
            android:action="com.example.tail.ACTION_VOICE_TRIGGER"
            android:targetPackage="com.example.tail"
            android:targetClass="com.example.tail.VoiceTriggerActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!--
        Static shortcut for "Text Trigger" — appears in Samsung Routines
        under "Then" → "Apps" → "Tail" → "Text Trigger".
        Launches TextTriggerActivity which starts VoiceHabitService in
        text-passthrough mode (expects pre-recognized text in EXTRA_TEXT,
        skips SpeechRecognizer).
    -->
    <shortcut
        android:shortcutId="text_trigger"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_text_trigger_short"
        android:shortcutLongLabel="@string/shortcut_text_trigger_long"
