# Tail Bridge Environment Variables
# Copy this file to .env and fill in your actual credentials

# Shared secret token — the Android app must send this in the X-App-Auth header.
# Use the SAME value as your Garmin proxy (ANDROID_PROXY_KEY) for convenience,
# or a different one if you prefer per-service isolation.
ANDROID_PROXY_KEY=your_secure_secret_token_here

# Port for the bridge server (default 8001; Garmin proxy uses 8000)
TAIL_BRIDGE_PORT=8001

# KDE Activity database path (default is the standard KDE location)
# KDE_ACTIVITY_DB=~/.local/share/kactivitymanagerd/resources/database

# Movie watcher poll interval in seconds (default 60)
# MOVIE_POLL_INTERVAL=60
